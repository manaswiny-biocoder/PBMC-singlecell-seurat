# Empty droplet detection
#First convert seurat to sce
# install packages


library(SingleCellExperiment)
library(DropletUtils)
sce <- as.SingleCellExperiment(seur_obj1) 

cat(ncol(sce) ,"intial droplet count")
cat(nrow(sce) , "intial feature count")



set.seed(100)
empty_drops <- emptyDrops(m= counts(sce), lower = 100, niters= 10000, test.ambient = TRUE)

empty_drops
hist(empty_drops$FDR, breaks = 100)


sum(empty_drops$FDR < 0.01, na.rm = TRUE) # no of cells called by empty drops as probable true cells.
sum(empty_drops$FDR < 0.05, na.rm = TRUE)
sum(empty_drops$FDR < 0.001, na.rm = TRUE)










# Identify cell

True_cell <- empty_drops$FDR<0.01
True_cell[is.na(True_cell)] <- FALSE


# Visual QC - the critical check!
empty_df <- data.frame(
  total_umi = colSums(counts(sce)),
  is_cell = True_cell)
empty_df


p2 <- ggplot(empty_df, aes(x = log10(total_umi + 1), fill = True_cell)) +
  geom_histogram(bins = 50, alpha = 0.7, position = "identity") +
  scale_fill_manual(
    values = c("TRUE" = "#2E86AB", "FALSE" = "#A23B72"),
    labels = c("Empty Droplet", "Cell"),
    name = "Classification"
  ) +
  labs(
    title = "EmptyDrops: Cell vs Empty Droplet Detection",
    subtitle = paste(sum(True_cell), "cells called from", ncol(sce), "total droplets"),
    x = "log10(UMI + 1)",
    y = "Number of Droplets"
  ) +
  theme_classic() +
  theme(plot.title = element_text(face = "bold", size = 14))

p2

ggsave("plots/02_empty_droplets.png", p2, width = 10, height = 6, dpi = 300)


