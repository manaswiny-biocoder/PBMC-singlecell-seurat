# NORMALIZE DATA and Find Variable Features

#Log-normalize
seur_obj1_qcmetric <- NormalizeData(seur_obj1_qcmetric, normalization.method = "LogNormalize", 
                                    scale.factor = 10000, verbose = FALSE)

# Find highly variable genes
seur_obj1_qcmetric<- FindVariableFeatures(seur_obj1_qcmetric, selection.method = "vst", 
                                          nfeatures = 2000, verbose = FALSE)

top10 <- head(VariableFeatures(seur_obj1_qcmetric), 10)
cat("Top 10 variable genes:", paste(top10, collapse = ", "), "\n")


# Visualize variable features
p10 <- VariableFeaturePlot(seur_obj1_qcmetric)
p10 <- LabelPoints(plot = p10, points = top10, repel = TRUE)
p10
ggsave("plots/05_variable_features.png", p10, width = 10, height = 7, dpi = 300)


# Scale the data

seur_obj1_qcmetric <- ScaleData(seur_obj1_qcmetric)

seur_obj1_qcmetric

seur_obj1_qcmetric <- RunPCA(seur_obj1_qcmetric, features = VariableFeatures(seur_obj1_qcmetric))

ElbowPlot(seur_obj1_qcmetric)

DimHeatmap(seur_obj1_qcmetric, dims = 1:10, cells = 500, balanced = TRUE)


seur_obj1_qcmetric <- FindNeighbors(seur_obj1_qcmetric, dims = 1:10)

seur_obj1_qcmetric <- FindClusters(seur_obj1_qcmetric, resolution = 1.0)

seur_obj1_qcmetric <- RunUMAP(seur_obj1_qcmetric, dims = 1:10)

DimPlot(seur_obj1_qcmetric, reduction = "umap", label = TRUE)
